local function Motor(Name, A, B, Hinge)
	local M = Instance.new("Motor6D"); M.Name = Name; M.Part0 = A; M.Part1 = B; M.C0 = A.CFrame:Inverse() * Hinge; M.C1 = B.CFrame:Inverse() * Hinge; M.Parent = A; return M
end
local function Rig(Mo, CF)
	local R = K.Part(Mo, "Root", Vector3.new(1, 1, 1), CF, Color3.new(1, 1, 1)); R.Transparency = 1; R.CanCollide = false; R.CanQuery = false; R.CanTouch = false
